{
  "name": "open-gemma-benchmark",
  "private": true,
  "type": "module",
  "scripts": {
    "benchmark:throughput": "node gemma-model-throughput.mjs",
    "benchmark:throughput:dry-run": "node gemma-model-throughput.mjs --dry-run",
    "benchmark:image": "node gemma-image-description.mjs",
    "benchmark:image:dry-run": "node gemma-image-description.mjs --dry-run",
    "benchmark:audio": "node gemma-audio-transcription.mjs",
